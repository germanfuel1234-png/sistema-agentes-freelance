# Copiar este archivo a ".env" (sin ".example") y completar los valores
# reales. El ".env" real NO se sube a git (ya esta en .gitignore).

# --- Postgres (base de datos de n8n) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambiar-por-una-clave-larga-random
POSTGRES_DB=n8n

# --- n8n ---
# Clave usada para encriptar las credenciales guardadas en n8n (tokens
# de WhatsApp, Google, etc.). Generarla UNA sola vez y no cambiarla
# despues - si cambia, n8n no puede volver a leer las credenciales ya
# guardadas. Generarla con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=cambiar-por-una-clave-random-de-32-bytes

# Mientras se prueba local sin tunel todavia, dejar localhost/http.
# Cuando se arme el tunel de Cloudflare (Fase 2 del plan), cambiar
# estos tres por el dominio real, ej:
#   N8N_HOST=n8n.tudominio.com
#   N8N_PROTOCOL=https
#   WEBHOOK_URL=https://n8n.tudominio.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
