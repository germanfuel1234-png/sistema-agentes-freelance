# ===== Google Sheets (Configuración) =====
# ID de la Sheet (se obtiene del URL)
GOOGLE_SHEET_ID=1hjwAUrKaCu53McleYaJZj99b65IoKHBVqIZ96qfvF1I
GOOGLE_SHEET_LEADS_RANGE='leads_tracking.csv'!A1:L1000
GOOGLE_SHEET_PRICES_RANGE=precios_base!A1:E100
GOOGLE_SHEET_BUDGETS_RANGE=presupuestos!A1:H100

# ===== Gmail (OAuth2) =====
# IMPORTANTE: Los valores abajo se cargan de credentials.json automáticamente
# Solo completar si necesitas override manual (no recomendado)
# GMAIL_CLIENT_ID=your_client_id_here
# GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:8000/callback

# ===== Gemini API =====
# Consigue en: https://makersuite.google.com/app/apikey
# Si NO lo tienes, el sistema usa templates y funciona igual
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Google Custom Search (para búsqueda de leads) =====
# Opcional: si no lo tienes, Agent 1 genera mocks
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# ===== Enriquecimiento de leads (Agent 1B) =====
# Opcional: se usan en cascada para completar el mail cuando el
# lead se encontró solo con nombre/empresa (sin mail real)
HUNTER_API_KEY=
SALESQL_API_KEY=

# ===== Configuración de Outreach =====
# Email principal (debe tener Gmail API activado en Google Cloud)
SENDER_EMAIL=rodriguezg.dev@gmail.com

# Email de test (para verificar que funciona)
TEST_EMAIL=germanty123@gmail.com

# Máximo de emails por día
DAILY_EMAIL_LIMIT=25

# ===== Logging & Debug =====
DEBUG=True
LOG_LEVEL=INFO

# ===== FastAPI (Dashboard web) =====
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# Limits
DAILY_EMAIL_LIMIT=20
LEADS_SEARCH_LIMIT=50

# Your Web Info
YOUR_WEBSITE_URL=https://germanrodriguez.ar
YOUR_EMAIL=tuemail@example.com
